# Placeholders only. Never commit a real .env file.
# Copy to .env and fill in real values locally; .env is git-ignored.

# ── Runtime ──────────────────────────────────────────────────────
# development | production
APP_ENV=development
PORT=8000

# ── Supabase (server-side only — must never ship in the extension) ──
# Project URL, e.g. https://your-project-ref.supabase.co
SUPABASE_URL=
# Server-side secret key (or the legacy service_role key, treated as equally sensitive).
SUPABASE_SECRET_KEY=

# ── Polar ────────────────────────────────────────────────────────
# Keep sandbox and production credentials separate.
POLAR_ACCESS_TOKEN=
# Signing secret used to verify inbound Polar webhooks.
POLAR_WEBHOOK_SECRET=
# The single server-configured one-time product. Clients cannot override this.
POLAR_PRODUCT_ID=

# ── Frontend / checkout ──────────────────────────────────────────
# Where Polar returns the user after a completed checkout.
SUCCESS_URL=
# Comma-separated list of exact allowed origins, e.g. chrome-extension://<32-char-id>
FRONTEND_ORIGIN=