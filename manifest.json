{
  "manifest_version": 3,
  "name": "Kyte - Best Website and URL Level Blocker",
  "version": "2.4.0",
  "description": "Block sites by domain or URL path. Run free focus sessions with optional paid Locked In Mode.",
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "permissions": [
    "storage",
    "tabs",
    "declarativeNetRequest",
    "declarativeNetRequestWithHostAccess",
    "alarms",
    "identity"
  ],
  "host_permissions": [
    "*://*/*"
  ],
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "background": {
    "service_worker": "service-worker.js"
  },
  "content_scripts": [
    {
      "matches": [
        "*://*/*"
      ],
      "css": [
        "content/content.css"
      ],
      "js": [
        "content/content.js"
      ],
      "run_at": "document_start",
      "all_frames": false
    }
  ],
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "ruleset_1",
        "enabled": true,
        "path": "rules/blocked_rules.json"
      }
    ]
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "buildkyte@gmail.com",
      "strict_min_version": "128.0",
      "data_collection_permissions": {
        "required": [
          "personallyIdentifyingInfo",
          "authenticationInfo",
          "financialAndPaymentInfo"
        ]
      }
    }
  }
}
